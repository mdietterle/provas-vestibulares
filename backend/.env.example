# Configurações de Banco de Dados e Segurança
DATABASE_URL=postgresql://postgres.nwrmgpxbvjydibjxrjfk:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Chave secreta para JWT
SECRET_KEY=troque-por-uma-chave-secreta-forte

# Tempo de expiração do token em minutos (padrão: 480 = 8h)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Correção de IA Online (Groq API) ──────────────────────────────────────────
# Chave de API Groq (obrigatória para todas as correções por IA online)
GROQ_API_KEY=

# Modelo oficial online para correção de textos, simulados e discursivas
GROQ_MODEL=openai/gpt-oss-120b

# Modelo oficial online para leitura de imagens e gabaritos
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Stripe (billing) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_CREDITS_PACK=
STRIPE_CREDITS_PACK_AMOUNT=100
