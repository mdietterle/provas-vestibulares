# 1. Patch ENEM service: add exam_name param + filter in loop
path = "backend/app/services/enem/pdf_import.py"
content = open(path).read()

# Add exam_name param to import_all_enem_exams signature
old_sig = "def import_all_enem_exams(since_year: int = 2015, until_year: Optional[int] = None, force_reimport: bool = False, db=None, **kwargs) -> dict:"
new_sig = "def import_all_enem_exams(since_year: int = 2015, until_year: Optional[int] = None, force_reimport: bool = False, exam_name: Optional[str] = None, db=None, **kwargs) -> dict:"
content = content.replace(old_sig, new_sig)

# Add exam_name filter after pending.extend line
old_extend = "            pending.extend((year, edition) for edition in editions)"
new_extend = """            for edition in editions:
                # Build exam_name the same way import_enem_pdf does, to allow filtering
                day = edition.get("day")
                color = edition.get("color")
                ed_name = f"ENEM {year} – Dia {day}"
                if color:
                    ed_name += f" ({color})"
                if exam_name is not None and exam_name != ed_name:
                    continue
                pending.append((year, edition))"""
content = content.replace(old_extend, new_extend)

